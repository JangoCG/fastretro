<div class="relative group">
  <div class="relative bg-white border border-zinc-900/10 shadow-soft p-4 hover:shadow-lift transition-all rounded-card overflow-hidden">
    <div class="flex flex-col items-center text-center">
      <%# Avatar %>
      <div class="relative mb-3">
        <div class="w-14 h-14 rounded-[.75rem] border-[2px] border-zinc-900 <%= avatar_color %> flex items-center justify-center text-white text-lg font-black shadow-soft">
          <%= @participant.initials %>
        </div>
        <%# Online Indicator %>
        <div class="absolute -bottom-1 -right-1 w-4 h-4 bg-emerald-500 border-[2px] border-white rounded-full"></div>
      </div>

      <%# Name %>
      <p class="font-black text-sm uppercase tracking-tight text-zinc-900 leading-tight mb-1 truncate max-w-full">
        <%= @participant.name %>
      </p>

      <%# Role Badge %>
      <span class="inline-block bg-zinc-900 text-white text-[0.5rem] font-bold px-2 py-0.5 uppercase tracking-widest">
        <%= role_label %>
      </span>

      <%# Role Toggle (admins only) %>
      <%= render role_button %>
    </div>
  </div>
</div>
