<div
  id="<%= dom_id(@retro) %>"
  class="group relative border-[2.5px] border-zinc-800 bg-[#ffffff] shadow-soft hover:shadow-soft transition-all duration-200 overflow-hidden rounded-[1.1rem]"
>
  <%# Stretched link - covers entire card %>
  <%= link_to retro_path(@retro), class: "absolute inset-0 z-10", "aria-label": @retro.name do %><% end %>

  <%# Top "Serial Number" Bar %>
  <div class="px-3 py-2 flex items-center gap-2 border-b-[2.5px] border-zinc-800 bg-white">
    <span class="text-[0.6rem] font-black text-zinc-900 uppercase tracking-widest">
      NO. <%= @retro.id %>
    </span>

    <div class="flex-1"></div>

    <%# Raw Action Buttons - z-20 places them above the stretched link %>
    <div class="flex items-center gap-2 relative z-20">
      <%= render IconButtonComponent.new(
        icon: "pencil",
        variant: :ghost,
        size: :sm,
        href: edit_retro_path(@retro),
        class: "text-zinc-900 hover:bg-zinc-200 rounded-[1.1rem] p-1",
        label: t("retros.retro_card.edit_retro")
      ) %>

      <%= button_to @retro,
            method: :delete,
            class: "w-6 h-6 flex items-center justify-center text-zinc-900 hover:bg-red-500 hover:text-white transition-colors border border-transparent hover:border-black rounded-[1.1rem]",
            data: { turbo_confirm: t("retros.retro_card.delete_confirm", name: @retro.name) } do %>
        <%= icon_tag "close", class: "text-sm font-bold" %>
      <% end %>
    </div>
  </div>

  <%# Main Content Area %>
  <div class="px-4 py-6">
    <%# Title in Quotes %>
    <h2 class="font-display font-black text-2xl text-zinc-900 uppercase leading-[0.9] tracking-tight">
      <%= @retro.name %>
    </h2>
  </div>

  <%# Footer Grid %>
  <div class="border-t-[2.5px] border-zinc-800 flex divide-x-[2.5px] divide-zinc-800">
    <%# Date Block %>
    <div class="flex-1 px-3 py-2 flex flex-col justify-center">
      <span class="text-[0.5rem] font-bold text-zinc-400 uppercase"><%= t("retros.retro_card.created") %></span>
      <div class="flex items-center gap-1">
        <span class="text-xs font-bold text-zinc-900 uppercase tracking-wide">
          <%= @retro.created_at.strftime("%b %d") %>
        </span>
      </div>
    </div>

    <%# Counter Block %>
    <div class="px-4 py-2 flex flex-col justify-center bg-zinc-100">
      <span class="text-[0.5rem] font-bold text-zinc-400 uppercase"><%= t("retros.retro_card.items") %></span>
      <div class="flex items-center gap-1.5">
        <span class="text-sm font-black text-zinc-900"><%= feedback_count %></span>
      </div>
    </div>
  </div>

  <%# Decorative Stripe Corner %>
</div>
