<%# Outer Container %>
<div id="actions-column" class="h-full flex flex-col relative group">
  <div class="relative flex flex-col h-full bg-[#f4f7fb] border border-zinc-900/10 shadow-lift overflow-hidden rounded-card">

    <%# Header %>
    <div class="px-5 py-5 border-b border-zinc-900/10 bg-white relative overflow-hidden">

      <div class="relative z-10 flex justify-between items-start gap-4">
        <div class="flex-1 min-w-0 overflow-hidden">
          <h2 class="font-display font-black text-2xl uppercase text-zinc-900 leading-[0.85] filter drop-shadow-sm">
            <span class="relative px-1 inline-block">
               <span class="absolute inset-0 -rotate-1 skew-x-3 scale-110 -z-10 mix-blend-multiply opacity-80" style="background-color: #ff5d03;"></span>
               <%= title %>
            </span>
          </h2>
        </div>

        <div class="relative z-20 flex-shrink-0">
           <%= render Actions::AddActionButtonComponent.new(retro: @retro) %>
        </div>
      </div>
    </div>

    <%# Body %>
    <div class="flex-1 p-4 overflow-y-auto bg-[#ffffff] relative">

      <div class="space-y-4 relative z-10">
        <% if actions.any? %>
          <% actions.each do |action| %>
            <%= render Actions::ActionComponent.new(action: action) %>
          <% end %>
        <% else %>
          <%# Empty State %>
          <div class="flex flex-col items-center justify-center py-16 text-center select-none">
             <div class="w-20 h-20 border border-zinc-900/10 flex items-center justify-center mb-6 relative">
               <%= icon_tag "check", class: "text-4xl text-zinc-900" %>
               <div class="absolute -top-2 -right-2 w-4 h-4 bg-[#ff5d03]"></div>
             </div>

             <p class="font-black text-zinc-900 text-xs uppercase tracking-widest mb-1">
               NO ACTIONS YET
             </p>
             <p class="font-ui text-[0.6rem] text-zinc-400 uppercase tracking-wide">WHAT DO WE DO NEXT?
             </p>

             <div class="mt-6 flex items-center gap-2">
               <div class="h-[2px] w-8 bg-zinc-300"></div>
               <span class="font-ui text-[0.5rem] text-zinc-400 uppercase">CLICK + ADD</span>
               <div class="h-[2px] w-8 bg-zinc-300"></div>
             </div>
          </div>
        <% end %>
      </div>
    </div>

  </div>
</div>
