<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <% unless @disable_view_transition %><meta name="view-transition" content="same-origin"><% end %>
    <title><%= content_for(:title) || "Faster Retro" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="<%= content_for(:robots) || "noindex, follow" %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Faster Retro">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= tag.link rel: "preload", href: asset_path("cabin-latin.woff2"), as: "font", type: "font/woff2", crossorigin: "anonymous" %>
    <%= tag.link rel: "preload", href: asset_path("inter-700-latin.woff2"), as: "font", type: "font/woff2", crossorigin: "anonymous" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%# Analytics %>
    <%= analytics_tag %>
  </head>
  <body class="bg-zinc-100 text-zinc-900 transition-colors min-h-screen flex flex-col font-sans antialiased overflow-x-hidden selection:bg-[#fff2d2] selection:text-black">

    <%# === BACKGROUND TEXTURE (The Dot Grid) === %>
    <div class="fixed inset-0 z-[-1] pointer-events-none opacity-[0.4]"
         style="background-image: radial-gradient(#7b8397 1px, transparent 1px); background-size: 24px 24px;">
    </div>

    <header class="py-6">
      <%# Industrial Header (non-interactive, no menu) %>
      <nav class="relative flex justify-center z-50">
        <%= link_to root_path(script_name: nil), class: "group" do %>
          <div class="relative inline-flex items-center gap-3 px-8 py-5 bg-[#ffffff] border-[2px] border-stone-300 shadow-soft group-hover:shadow-soft transition-all duration-75 overflow-hidden min-w-[280px]">

            <%# Decorative Hazard Strip %>
            <div class="absolute top-0 left-0 w-full h-1 bg-[repeating-linear-gradient(45deg,#000,#000_10px,transparent_10px,transparent_20px)] opacity-10"></div>

            <%# Meta Label %>
            <div class="absolute top-2 left-2 flex flex-col items-start gap-0.5 pointer-events-none">
              <span class="text-[0.45rem] font-bold text-stone-400 uppercase leading-none tracking-widest">NAV_SYS</span>
              <span class="text-[0.4rem] font-mono text-stone-300 uppercase leading-none">V 2.0</span>
            </div>

            <%# Main Label %>
            <div class="flex flex-col items-start pt-3 pb-1 w-full relative z-10">
              <div class="flex items-center gap-2">
                <span class="font-black text-xl sm:text-2xl uppercase tracking-tighter text-black leading-none select-none relative px-1">
                  <span class="absolute inset-0 bg-[#fff2d2] -rotate-1 skew-x-3 scale-110 -z-10 mix-blend-multiply opacity-80"></span>
                  "FASTER RETRO"
                </span>
              </div>
            </div>

          </div>
        <% end %>
      </nav>
    </header>

    <%= render "layouts/shared/flash" %>

    <main class="flex-1 flex items-center justify-center px-4">
      <div class="w-full max-w-md">
        <%= yield %>
      </div>
    </main>
    <%= render SiteFooterComponent.new %>
  </body>
</html>
