<% content_for :title, t("signups.new.title") %>
<div class="max-w-md mx-auto px-4 py-8 font-sans <%= 'animate-[shake_400ms_both]' if flash[:shake] %>">
  
  <%# Industrial Container %>
  <div class="bg-[#ffffff] border border-zinc-900/10 shadow-lift relative rounded-card overflow-hidden">
    
    <%# Header Section %>
    <div class="p-6 border-b border-zinc-900/10 bg-white relative">
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:10px_10px]"></div>

      <div class="relative z-10">
        <h1 class="text-xl font-black text-zinc-900 uppercase">
           <%= t("signups.new.heading") %>
        </h1>
      </div>
    </div>

    <%# Body %>
    <div class="p-8 relative">
       
       <%= form_with model: @signup, url: signup_path, scope: "signup", class: "flex flex-col gap-6 relative z-10", data: { turbo: false, controller: "form" } do |form| %>
        
        <div class="flex flex-col gap-2">
           <label class="text-xs font-bold text-zinc-500 uppercase tracking-widest font-ui"><%= t("signups.new.email_label") %></label>
           <%= form.email_field :email_address,
              required: true,
              class: "w-full px-4 py-3 bg-white border-[2px] border-zinc-900 text-zinc-900 font-bold placeholder-zinc-400 focus:outline-none focus:bg-tint-butter focus:shadow-soft transition-all rounded-[.875rem]",
              autofocus: true,
              autocomplete: "username",
              placeholder: t("shared.email_placeholder") %>
        </div>

        <div class="bg-zinc-100 p-3 border-[2px] border-zinc-200 border-dashed">
             <p class="text-[0.65rem] font-bold text-zinc-500 uppercase tracking-wide leading-relaxed">
               <%= t("signups.new.hint") %>
             </p>
        </div>

        <button type="submit" class="group relative flex items-center justify-center gap-3 w-full py-4 bg-flame text-white border-[2px] border-transparent font-black uppercase tracking-widest text-sm shadow-soft hover:brightness-95 transition-all rounded-pill">
          <span><%= t("signups.new.sign_up") %></span>
          <i class="icon icon--arrow-right text-lg pt-0.5 group-hover:translate-x-1 transition-transform"></i>
        </button>

      <% end %>

    </div>
    
    <%# Footer %>
    <div class="p-4 border-t border-zinc-900/10 bg-white flex justify-center">
       <span class="text-[0.65rem] font-bold text-zinc-400 uppercase tracking-widest">
         <%= t("signups.new.already_have_account") %> <%= link_to t("signups.new.sign_in_link"), new_session_path, class: "text-zinc-900 underline hover:no-underline" %>
       </span>
    </div>
  </div>
</div>
