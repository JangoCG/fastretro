<% if FastRetro.saas? && Current.user.owner? %>
  <% subscription = Current.account.subscription %>
  <% free_limit = @free_limit || Plan.free.retro_limit %>
  <% paid_price = @paid_price %>
  <% formatted_paid_price = paid_price.present? ? format_currency(paid_price) : nil %>
  <section id="subscription" class="border-[3px] border-zinc-900 bg-[#f4f7fb] shadow-lift">
    <div class="px-6 py-4 border-b-[3px] border-zinc-900 bg-white text-center">
      <h2 class="text-lg font-black text-zinc-900 uppercase tracking-wider"><%= t("account.settings.subscription.heading") %></h2>
    </div>

    <div class="p-6 md:p-8 space-y-5 text-center">
      <% if Current.account.plan.free? %>
        <h3 class="text-2xl md:text-4xl font-black text-zinc-900 leading-tight tracking-tight">
          <%= t("account.settings.subscription.used_retros_html", used: number_with_delimiter(Current.account.retros_count), limit: number_with_delimiter(free_limit)) %>
        </h3>

        <% if formatted_paid_price.present? %>
          <p class="text-zinc-800 text-lg md:text-2xl leading-snug">
            <%= t("account.settings.subscription.upgrade_prompt_html", limit: number_with_delimiter(free_limit), price: formatted_paid_price) %>
          </p>

          <%= button_to t("account.settings.subscription.upgrade_button", price: formatted_paid_price), account_subscription_path,
              id: "stripe-checkout-button",
              class: "w-full md:w-fit mx-auto flex items-center justify-center text-center bg-gradient-to-r from-[#ff5d03] to-[#ff5d03] text-white hover:from-[#ff5d03] hover:to-[#ff5d03] px-6 py-3 text-base md:text-xl font-black tracking-wide transition-all border-[3px] border-zinc-900 shadow-soft hover:shadow-soft",
              form: { id: "stripe-checkout-form", data: { turbo: false } } %>
        <% else %>
          <p class="text-red-700 text-base md:text-xl leading-snug font-bold">
            <%= t("account.settings.subscription.pricing_unavailable") %>
          </p>

          <%= button_to t("account.settings.subscription.open_checkout"), account_subscription_path,
              id: "stripe-checkout-button",
              class: "w-full md:w-fit mx-auto flex items-center justify-center text-center bg-gradient-to-r from-[#ff5d03] to-[#ff5d03] text-white hover:from-[#ff5d03] hover:to-[#ff5d03] px-6 py-3 text-base md:text-xl font-black tracking-wide transition-all border-[3px] border-zinc-900 shadow-soft hover:shadow-soft",
              form: { id: "stripe-checkout-form", data: { turbo: false } } %>
        <% end %>

        <p class="text-zinc-700 text-lg md:text-2xl"><%= t("account.settings.subscription.cancel_anytime") %></p>

        <p class="text-[#ff5d03] text-lg md:text-2xl leading-snug">
          <%= t("account.settings.subscription.current_plan_free_html", plan: Current.account.plan.name, limit: number_with_delimiter(free_limit)) %>
        </p>
      <% else %>
        <h3 class="text-2xl md:text-4xl font-black text-zinc-900 leading-tight tracking-tight">
          <%= t("account.settings.subscription.thank_you") %>
        </h3>

        <p class="text-zinc-800 text-lg md:text-2xl leading-snug">
          <%= t("account.settings.subscription.current_plan_paid_html", plan: Current.account.plan.name) %>
        </p>

        <% if subscription&.current_period_end %>
          <p class="text-zinc-700 text-base md:text-xl">
            <%= subscription_period_end_action(subscription) %>
            <strong><%= subscription.current_period_end.to_date.to_fs(:long) %></strong>
          </p>
        <% end %>

        <%= link_to t("account.settings.subscription.manage_billing"), account_billing_portal_path,
            class: "w-full md:w-fit mx-auto flex items-center justify-center text-center bg-zinc-900 text-white hover:bg-zinc-800 px-6 py-3 text-base md:text-xl font-black tracking-wide transition-all border-[3px] border-zinc-900 shadow-soft hover:shadow-soft",
            data: { turbo: false } %>
      <% end %>
    </div>
  </section>
<% end %>
