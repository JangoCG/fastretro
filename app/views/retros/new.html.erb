<% content_for :title, t("retros.new.title") %>

<div class="max-w-7xl mx-auto px-4 py-12">
  <%= render "retros/near_limit_notice" %>

  <%# Navigation Header %>
  <div class="flex items-center justify-between mb-16 border-b-2 border-black pb-4">
    <%= render BackButtonComponent.new(label: t("shared.retros"), href: retros_path) %>
  </div>

  <div class="max-w-2xl mx-auto">
    <%# Page header %>
    <div class="border-l-4 border-black pl-6 py-4 mb-8">
      <h1 class="text-5xl font-display font-black text-black leading-[0.9]">
        <%= t("retros.new.heading") %>
      </h1>
    </div>

    <%# Card %>
    <div class="bg-zinc-100 border-2 border-black p-8 shadow-lift rounded-card overflow-hidden">
      <%= render "form", retro: @retro %>
    </div>
  </div>
</div>
