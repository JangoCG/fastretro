<% content_for :title, t("retro_invites.title", name: @retro.name) %>

<div class="max-w-md mx-auto px-4 py-8 font-sans">

  <%# Card container %>
  <div class="bg-[#ffffff] border border-zinc-900/10 shadow-lift relative rounded-card overflow-hidden">

    <%# Header %>
    <div class="p-6 border-b border-zinc-900/10 bg-white relative">

      <div class="relative z-10">
        <p class="font-ui text-[10px] text-zinc-400 uppercase tracking-widest mb-1">
          <%= t("retro_invites.invited_to") %>
        </p>
        <h1 class="text-2xl font-display font-black uppercase tracking-tight text-zinc-900 leading-tight">
          <%= @retro.name %>
        </h1>
        <p class="font-ui text-xs text-zinc-500 mt-2 uppercase">
          <%= t("retro_invites.team") %> <%= @join_code.account.name %>
        </p>
      </div>
    </div>

    <%# Body %>
    <div class="p-6 relative bg-white">

      <%= form_with url: retro_invite_path(code: @join_code.code, retro_id: @retro.id), method: :post, class: "flex flex-col gap-6 relative z-10" do |form| %>

        <div class="flex flex-col gap-2">
          <label class="text-xs font-bold text-zinc-500 uppercase tracking-widest font-ui">
            <%= t("retro_invites.enter_email") %>
          </label>
          <%= form.email_field :email_address,
             required: true,
             class: "w-full px-4 py-3 bg-[#ffffff] border-[2px] border-zinc-900 text-zinc-900 font-bold placeholder-zinc-400 focus:outline-none focus:bg-white focus:shadow-soft transition-all rounded-[.875rem]",
             autofocus: true,
             autocomplete: "username",
             placeholder: "your@email.com",
             value: Current.identity&.email_address %>
        </div>

        <div class="p-2 border-l-[3px] border-zinc-300">
          <p class="text-[0.65rem] font-bold text-zinc-400 uppercase tracking-wide leading-relaxed">
            <%= t("retro_invites.magic_link_hint") %>
          </p>
        </div>

        <button type="submit" class="group relative flex items-center justify-center gap-3 w-full py-4 bg-zinc-900 text-[#ffffff] border-[2px] border-zinc-900 font-black uppercase tracking-widest text-sm hover:-translate-y-1 hover:shadow-soft active:translate-y-0 active:shadow-none transition-all rounded-pill">
          <span><%= t("retro_invites.join_retro") %></span>
          <i class="icon icon--arrow-right text-lg pt-0.5 group-hover:translate-x-1 transition-transform"></i>
        </button>

      <% end %>

    </div>

    <%# Footer hint %>
    <div class="p-4 border-t border-zinc-900/10 bg-[#ffffff] flex justify-center">
      <span class="text-[0.65rem] font-bold text-zinc-400 uppercase tracking-widest">
        <%= t("retro_invites.footer_hint") %>
      </span>
    </div>
  </div>
</div>
