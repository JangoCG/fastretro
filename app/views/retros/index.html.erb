<% content_for :title, t("retros.index.title") %>
<div class="max-w-7xl mx-auto p-4 sm:p-6" data-controller="filter">
  <%= render "retros/near_limit_notice" %>

  <% if notice.present? %>
    <div class="border border-zinc-900/10 bg-tint-butter px-5 py-4 mb-8 font-ui text-xs font-bold uppercase shadow-soft inline-block rounded-pill" id="notice">
      <%= notice %>
    </div>
  <% end %>

  <%# Page header %>
  <div class="mb-10 sm:mb-12">
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-display font-black text-black leading-[0.9]">
      <%= t("retros.index.your_retros") %>
    </h1>

    <div class="mt-6 grid grid-cols-1 lg:grid-cols-[minmax(0,28rem)_auto] xl:grid-cols-[minmax(0,1fr)_auto] gap-4 xl:gap-6 items-center">
      <%# Search %>
      <div class="relative w-full">
        <input
          type="text"
          placeholder="<%= t("shared.search") %>"
          class="block w-full pl-5 pr-12 py-3 bg-white border border-zinc-900/15 font-ui text-sm rounded-pill focus:outline-none focus:ring-2 focus:ring-flame focus:border-transparent transition-all"
          data-filter-target="input"
          data-controller="hotkey"
          data-action="input->filter#filter keydown.f@window->hotkey#focus"
        >
        <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
          <%= render KbdComponent.new(key: "F", size: :sm) %>
        </div>
      </div>

      <%# Primary Actions %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4 xl:flex xl:items-center">
        <%= link_to new_retro_path, id: "new-retro-button", class: "group inline-flex h-12 min-w-[14rem] items-center justify-center gap-2 bg-flame text-white hover:brightness-95 rounded-pill font-bold uppercase px-5 sm:px-6 text-sm tracking-wider border-2 border-transparent transition-all shadow-soft hover:shadow-soft hover:-translate-y-1 hover:-translate-x-1 rounded-pill", data: { controller: "hotkey", action: "keydown.c@document->hotkey#click" } do %>
          <span><%= t("retros.index.new_retro") %></span>
          <span class="font-ui group-hover:translate-x-1 transition-transform">-></span>
          <span class="hidden sm:inline">
            <%= render KbdComponent.new(key: "C", size: :sm) %>
          </span>
        <% end %>

        <%= link_to new_site_feedback_path(script_name: nil), class: "inline-flex h-12 min-w-[14rem] items-center justify-center gap-2 px-4 sm:px-5 bg-transparent text-zinc-900 border-2 border-zinc-900/20 font-bold uppercase tracking-widest text-sm hover:border-flame hover:text-flame transition-colors rounded-pill" do %>
          <%= icon_tag "chat", class: "w-4 h-4" %>
          <%= t("retros.index.give_feedback") %>
        <% end %>
      </div>
    </div>

    <div class="mt-8 border-b border-zinc-900/10"></div>
  </div>

  <%# Retros List Grid %>
  <div id="retros" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 items-start">
    <% if @retros.any? %>
      <% @retros.each do |retro| %>
        <div data-filter-target="item">
          <%= render Retros::RetroCardComponent.new(retro: retro, feedback_count: @feedback_counts[retro.id] || 0) %>
        </div>
      <% end %>

      <%# No Results State %>
      <div data-filter-target="blankSlate" class="hidden col-span-full py-16 text-center border-2 border-dashed border-zinc-300">
        <p class="font-ui text-zinc-400 uppercase"><%= t("retros.index.no_matches_found") %></p>
      </div>
    <% else %>
      <%# Empty State %>
      <div class="col-span-full py-24 text-center border-2 border-dashed border-zinc-300 bg-zinc-50">
        <div class="max-w-md mx-auto">
          <p class="text-2xl font-display font-black uppercase tracking-tight mb-4"><%= t("retros.index.no_retros_yet") %></p>
          <p class="font-ui text-sm text-zinc-500 mb-8"><%= t("retros.index.start_first_retro") %></p>
          
          <%= link_to new_retro_path, class: "inline-block bg-black text-white hover:bg-zinc-800 font-bold uppercase px-6 py-3 text-sm tracking-wider" do %>
            <%= t("retros.index.create_first_retro") %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
