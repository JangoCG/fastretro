<% content_for :title, t("retros.edit.title", name: @retro.name) %>
<div class="px-4 py-4">
  <%= render BackButtonComponent.new(label: t("shared.retro"), href: retro_path(@retro), variant: :fizzy) %>
</div>

<div class="max-w-2xl mx-auto px-4 py-8 font-sans">
  <%# Industrial Container %>
  <div class="bg-[#ffffff] border border-zinc-900/10 shadow-lift relative rounded-card overflow-hidden">
    
    <%# Header Section %>
    <div class="p-6 border-b border-zinc-900/10 bg-white relative">
       <%# Background Grid %>
      
      <div class="relative z-10 flex items-center justify-between">
        <h1 class="text-2xl font-display font-black text-zinc-900 uppercase">
           <%= t("retros.edit.heading") %>
        </h1>

        <span class="inline-flex items-center px-2 py-1 border-[2px] border-zinc-900 bg-blue-100 text-blue-900 text-[0.6rem] font-bold uppercase tracking-widest">
           NO. <%= @retro.id %>
        </span>
      </div>
    </div>

    <%# Content area %>
    <div class="p-6 relative">
       <%# Background Grid %>
       
       <div class="relative z-10">
        <%= render "form", retro: @retro %>
       </div>
    </div>

    <%# Footer Metadata %>
    <div class="px-6 py-4 border-t border-zinc-900/10 bg-zinc-50 flex items-center justify-between text-xs font-ui uppercase text-zinc-500">
      <div class="flex items-center gap-2">
        <span class="font-bold text-zinc-900"><%= t("shared.created") %>:</span>
        <span><%= time_ago_in_words(@retro.created_at) %> <%= t("shared.ago") %></span>
      </div>
      <div class="flex items-center gap-1">
         <span class="text-zinc-900 font-bold"><%= @retro.feedbacks.published.count %></span>
         <span><%= t("shared.items") %></span>
      </div>
    </div>
  </div>

  <%# Action button (Heavy) %>
  <div class="flex justify-center gap-3 mt-8">
     <button type="submit" form="retro-form"
        class="group relative inline-flex items-center justify-center gap-2 px-8 py-3 bg-zinc-900 text-[#ffffff] border-[2px] border-zinc-900 font-bold uppercase tracking-widest text-xs hover:-translate-y-1 hover:shadow-soft active:translate-y-0 active:shadow-none transition-all rounded-pill">
        <%= t("retros.edit.save_changes") %>
        <%= render KbdComponent.new(key: "Cmd+Enter", size: :sm) %>
      </button>
  </div>
</div>
