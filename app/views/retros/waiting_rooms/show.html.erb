<% content_for :title, t("waiting_rooms.show.title", name: @retro.name) %>
<%= turbo_stream_from @retro %>
<%= turbo_stream_from [@retro, Current.user] if Current.user.present? %>
<%= turbo_refreshes_with method: :morph, scroll: :preserve %>

<div class="max-w-7xl mx-auto px-4 py-12">

  <%# Navigation Header %>
  <div class="flex items-center justify-between mb-12 border-b-2 border-black pb-4">
    <%= render BackButtonComponent.new(label: t("shared.retros"), href: retros_path) %>
    <span class="font-ui text-xs text-zinc-400 uppercase hidden sm:inline-block"><%= t("waiting_rooms.show.waiting_room_label") %></span>
  </div>

  <%# Main Grid Layout %>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

    <%# Left Column: Waiting Status %>
    <div class="lg:col-span-7">
      <%# Page header %>
      <div class="border-l-4 border-black pl-6 py-4 mb-8">
        <p class="font-ui text-xs text-zinc-500 mb-2 uppercase tracking-widest">
          <%= t("waiting_rooms.show.retro_id", id: @retro.id) %>
        </p>
        <h1 class="text-4xl md:text-5xl font-display font-black text-black leading-[0.9]">
          <%= @retro.name %>
        </h1>
        <p class="font-ui text-xs text-zinc-400 mt-2 uppercase">
          CREATED: <%= @retro.created_at.strftime("%Y.%m.%d // %H:%M:%S") %>
        </p>
      </div>

      <%# Waiting Status Card %>
      <div class="bg-zinc-900 text-white border border-zinc-900/10 p-8 shadow-lift relative overflow-hidden mb-8 rounded-card">
        <%# Background Grid Overlay %>
        <div class="absolute inset-0 opacity-10 pointer-events-none"
             style="background-image: linear-gradient(0deg, transparent 24%, #ffffff 25%, #ffffff 26%, transparent 27%, transparent 74%, #ffffff 75%, #ffffff 76%, transparent 77%, transparent), linear-gradient(90deg, transparent 24%, #ffffff 25%, #ffffff 26%, transparent 27%, transparent 74%, #ffffff 75%, #ffffff 76%, transparent 77%, transparent); background-size: 30px 30px;">
        </div>

        <div class="relative z-10">
          <div class="flex items-center justify-between border-b border-zinc-700 pb-4 mb-8">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 bg-amber-400 rounded-full animate-pulse"></span>
              <span class="font-ui text-xs font-bold uppercase tracking-widest text-zinc-400"><%= t("waiting_rooms.show.waiting_for_team") %></span>
            </div>
            <span class="font-ui text-[10px] text-zinc-500"><%= t("waiting_rooms.show.session_id", id: @retro.id) %></span>
          </div>

          <div class="text-center py-6">

            <div class="flex items-center justify-center gap-2 mb-6">
              <span class="w-2 h-2 bg-amber-400 rounded-full animate-bounce" style="animation-delay: 0ms;"></span>
              <span class="w-2 h-2 bg-amber-400 rounded-full animate-bounce" style="animation-delay: 150ms;"></span>
              <span class="w-2 h-2 bg-amber-400 rounded-full animate-bounce" style="animation-delay: 300ms;"></span>
            </div>
            <p class="text-xl font-black uppercase tracking-tight text-white">
              <%= t("waiting_rooms.show.waiting_for_everyone") %>
            </p>
          </div>
        </div>
      </div>

      <%= render "participants_section", retro: @retro, participants: @participants %>

      <%# Start Retro Button %>
      <% if Current.user && @retro.admin?(Current.user) %>
        <%= turbo_frame_tag "start-retro-container" do %>
          <%= button_to retro_start_path(@retro), method: :post,
              id: "start-retro-button",
              form: { data: { turbo_frame: "_top" } },
              class: "group w-full bg-[#fff2d2] text-black hover:bg-white font-bold uppercase px-6 py-5 text-base tracking-wider flex items-center justify-between border border-zinc-900/10 transition-all shadow-lift hover:shadow-lift rounded-pill" do %>
            <span><%= t("waiting_rooms.show.start_retro") %></span>
            <span class="font-ui group-hover:translate-x-2 transition-transform text-lg">-></span>
          <% end %>
        <% end %>
      <% else %>
        <div class="w-full bg-zinc-100 text-zinc-500 font-bold uppercase px-6 py-5 text-base tracking-wider flex items-center justify-center border border-zinc-900/10 rounded-pill">
          <span><%= t("waiting_rooms.show.waiting_for_facilitator") %></span>
        </div>
      <% end %>
    </div>

    <%# Right Column: Invite Card %>
    <div class="lg:col-span-5">
      <div class="lg:sticky lg:top-8">
        <%= render RetroInviteCardComponent.new(retro: @retro) %>

        <%# Tips Card %>
        <div class="mt-6 border border-zinc-900/10 bg-[#f4f7fb] p-5 shadow-soft rounded-[1.1rem]">
          <h3 class="font-black text-sm uppercase tracking-tight text-zinc-900 mb-3">
            <%= t("waiting_rooms.show.how_it_works") %>
          </h3>
          <ul class="space-y-2 text-xs text-zinc-600 font-ui uppercase">
            <li class="flex items-start gap-2">
              <span class="text-zinc-400">01.</span>
              <span><%= t("waiting_rooms.show.step_1") %></span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-zinc-400">02.</span>
              <span><%= t("waiting_rooms.show.step_2") %></span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-zinc-400">03.</span>
              <span><%= t("waiting_rooms.show.step_3") %></span>
            </li>
          </ul>
        </div>
      </div>
    </div>

  </div>
</div>
