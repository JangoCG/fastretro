<% content_for :title, t("sessions.new.title") %>
<div class="max-w-md mx-auto px-4 py-8 font-sans <%= 'animate-[shake_400ms_both]' if flash[:shake] %>">

  <%# Card container %>
  <div class="bg-[#ffffff] border border-zinc-900/10 shadow-lift relative rounded-card overflow-hidden">

    <%# Body %>
    <div class="p-8 relative bg-white">
       
       <%= form_with url: session_path, class: "flex flex-col gap-6 relative z-10" do |form| %>
        
        <div class="flex flex-col gap-2">
           <label class="text-xs font-bold text-zinc-500 uppercase tracking-widest font-ui"><%= t("sessions.new.email_label") %></label>
           <%= form.email_field :email_address,
              required: true,
              class: "w-full px-4 py-3 bg-[#ffffff] border border-zinc-900/20 text-zinc-900 font-bold placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-flame focus:border-transparent transition-all rounded-[.875rem]",
              autofocus: true,
              autocomplete: "username webauthn",
              placeholder: t("shared.email_placeholder") %>
        </div>

        <div class="p-2 border-l-[3px] border-zinc-300">
             <p class="text-[0.65rem] font-bold text-zinc-400 uppercase tracking-wide leading-relaxed">
               <%= t("sessions.new.magic_link_hint") %>
             </p>
        </div>

        <button type="submit" class="group relative flex items-center justify-center gap-3 w-full py-4 bg-flame text-white border-[2px] border-transparent font-black uppercase tracking-widest text-sm shadow-soft hover:brightness-95 transition-all rounded-pill">
          <span><%= t("sessions.new.sign_in") %></span>
          <i class="icon icon--arrow-right text-lg pt-0.5 group-hover:translate-x-1 transition-transform"></i>
        </button>

      <% end %>

      <div class="mt-4 flex justify-center">
        <%= passkey_sign_in_button session_passkey_path,
              options: @authentication_options,
              mediation: "conditional",
              error: { class: "text-red-600 text-xs font-bold uppercase mt-2" },
              cancellation: { class: "text-zinc-400 text-xs font-bold uppercase mt-2" },
              class: "text-xs font-bold text-zinc-500 uppercase tracking-widest hover:text-zinc-900 transition-colors cursor-pointer" do %>
          <%= t("sessions.new.sign_in_with_passkey") %>
        <% end %>
      </div>

    </div>

    <%# Footer %>
    <div class="p-4 border-t border-zinc-900/10 bg-[#ffffff] flex justify-center">
       <span class="text-[0.65rem] font-bold text-zinc-400 uppercase tracking-widest">
         <%= t("sessions.new.new_here") %> <%= link_to t("sessions.new.sign_up_link"), new_signup_path, class: "text-zinc-900 underline hover:no-underline" %> <%= t("sessions.new.create_account") %>
       </span>
    </div>
  </div>
</div>
