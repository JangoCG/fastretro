<% content_for :title, t("users.email_addresses.confirmations.title") %>

<div class="max-w-md mx-auto px-4 py-8 font-sans">
  <div class="bg-[#ffffff] border border-zinc-900/10 shadow-lift relative rounded-card overflow-hidden">
    <div class="p-6 border-b border-zinc-900/10 bg-white relative">
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:10px_10px]"></div>
      <div class="relative z-10">
        <h1 class="text-xl font-black text-zinc-900 uppercase">
          <%= t("users.email_addresses.confirmations.heading") %>
        </h1>
      </div>
    </div>

    <div class="p-8 relative text-center">
      <div class="absolute inset-0 pointer-events-none bg-[linear-gradient(to_right,#8080800a_1px,transparent_1px),linear-gradient(to_bottom,#8080800a_1px,transparent_1px)] bg-[size:20px_20px]"></div>
      <div class="relative z-10">
        <p class="text-[0.8rem] text-zinc-600 font-bold uppercase tracking-wide mb-6">
          <%= t("users.email_addresses.confirmations.confirming") %>
        </p>

        <%= form_with url: user_email_address_confirmation_path(user_id: @user.id, email_address_token: params[:email_address_token]), method: :post, data: { controller: "form auto-submit" } do |form| %>
          <%= form.hidden_field :email_address_token, value: params[:email_address_token] %>

          <button type="submit" class="group relative inline-flex items-center justify-center px-8 py-3 bg-zinc-900 text-[#ffffff] border-[2px] border-zinc-900 font-bold uppercase tracking-widest text-xs hover:-translate-y-0.5 hover:shadow-soft active:translate-y-0 active:shadow-none transition-all rounded-pill" data-form-target="submit">
            <%= t("users.email_addresses.confirmations.confirm_button") %>
          </button>
        <% end %>
      </div>
    </div>

    <div class="h-2 border-t border-zinc-900/10 bg-zinc-900 w-full"></div>
  </div>
</div>
